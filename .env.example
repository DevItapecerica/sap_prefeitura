NODE_ENV=development
APPLICATION_PORT=3000
DATABASE_URL=mariadb://user:password@localhost:3306/prefeitura
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
MAIL_ADRESS=no-reply@example.gov.br
MAIL_PASSWORD=replace-me
MAIL_HOST=smtp.example.gov.br
MAIL_PORT=587
MAIL_SECURE=false
PDF_API_URL=http://localhost:3001
PROTOCOL_PUBLIC_URL=http://localhost:5173/protocolo
PROTOCOL_STORAGE_DIR=./private/protocolos
PROTOCOL_MAX_FILE_BYTES=10485760
PROTOCOL_CODE_TTL_MINUTES=10
PROTOCOL_TOKEN_SECRET=replace-with-a-different-long-random-secret
PROTOCOL_PRIVACY_CONTACT_URL=https://www.itapecerica.sp.gov.br/transparencia
# Habilite a pré-seleção de retenção somente após aprovação formal:
# PROTOCOL_RETENTION_POLICY_REFERENCE=Decreto-ou-tabela-de-temporalidade-aprovada
# PROTOCOL_RETENTION_DAYS=3650
PROTOCOL_ALERT_OVERDUE_THRESHOLD=10
PROTOCOL_ALERT_FAILED_NOTIFICATIONS_THRESHOLD=1
PROTOCOL_ALERT_OPEN_PRIVACY_DAYS=10
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
# Usado somente pelo perfil Docker "operations". Guarde em cofre de segredos.
PROTOCOL_BACKUP_PASSPHRASE=replace-with-at-least-20-random-characters
