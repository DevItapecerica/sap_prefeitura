DATABASE_URL='mariadb://user:change-database-password@localhost:3306/sap_prefeitura'
# Standalone Docker Compose: change DATABASE_URL host to db and use these credentials.
DATABASE_USER=user
DATABASE_KEY=change-database-password
DATABASE_ROOT_PASSWORD=change-root-password
DATABASE_NAME=sap_prefeitura

# used to crypt data
SECRET_KEY='replace-with-at-least-32-random-characters'
# Independent key for signing JWTs. Do not reuse SECRET_KEY.
JWT_KEY='replace-with-an-independent-random-jwt-key'
METRICS_TOKEN='replace-with-a-dedicated-random-monitoring-token'

PDF_API_URL='http://localhost:3002/api/v1'
# Required in production. Native execution: writable private directory.
# Docker Compose uses /var/lib/sap/ft-reports with a persistent volume.
FT_REPORT_ARCHIVE_DIR=./storage/ft-reports

APPLICATION_PORT=3000
CORS_ORIGINS='http://localhost:5173'

# Comma-separated proxy IPs or CIDR ranges allowed to provide forwarded IPs.
# Leave empty when the API is accessed directly.
TRUSTED_PROXIES=

# SMTP. Use MAIL_SECURE=true only for implicit TLS, normally on port 465.
# Ports 25 and 587 normally use MAIL_SECURE=false and negotiate STARTTLS.
MAIL_HOST='smtp.example.gov.br'
MAIL_PORT=25
MAIL_SECURE=false
MAIL_ADRESS='no-reply@example.gov.br'
MAIL_PASSWORD='change-me'

# development, test or production
NODE_ENV=development

# First administrator seed. Required when NODE_ENV=production and there is no
# active administrator yet. Development falls back to admin@admin.com / admin.
BOOTSTRAP_ADMIN_EMAIL='admin@example.gov.br'
BOOTSTRAP_ADMIN_PASSWORD='change-me'

# Auth/session
# Access token: 15 minutes.
# Refresh token: HttpOnly cookie, session valid for 30 minutes, path /api.
# In production, NODE_ENV=production enables the Secure cookie flag.
