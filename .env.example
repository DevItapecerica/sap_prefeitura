DATABASE_URL='Sua URL do banco de dados'

SECRET_KEY=jwtpass
API_KEY=key

PDF_API_URL='sua-url'
PDF_API_KEY='sua-key'

APPLICATION_PORT=port
CORS_ORIGINS='Configure-o-cors'

# man, dev or prod
NODE_ENV=dev

# Auth/session
# Access token: 15 minutes.
# Refresh token: HttpOnly cookie, 8 hours, path /api.
# In production, NODE_ENV=production enables the Secure cookie flag.
